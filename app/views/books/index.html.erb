<h1>Book Collection</h1>

<% if notice %>
  <p><%= notice %></p>
<% end %>

<%= link_to "Add a Book", new_book_path %>

<hr>

<% @books.each do |book| %>
  <div>
    <strong><%= book.title %></strong><br>

    Author: <%= book.author %><br>
    Price: <%= book.price %><br>
    Published: <%= book.published_date %><br>

    <%= link_to "Show", book_path(book) %>
    <%= link_to "Edit", edit_book_path(book) %>
    <%= link_to "Delete", delete_book_path(book) %>
  </div>

  <hr>
<% end %>